# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/

# ---------------------------------------------------------------------------
# Build output
# (bare names match at any depth: every package's lib/ and dist/ is covered)
# ---------------------------------------------------------------------------
lib/
dist/
*.tsbuildinfo

# Scratch tree the typert generator builds a package in; it removes it again,
# but a build in progress must not be stageable.
.typert-workspace/

# ---------------------------------------------------------------------------
# Nx runtime state
# `.nx/version-plans/` holds nx release version plans and IS source-controlled
# ---------------------------------------------------------------------------
.nx/cache/
.nx/workspace-data/

# ---------------------------------------------------------------------------
# Test coverage & reports
# ---------------------------------------------------------------------------
coverage/
.nyc_output/

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Tool caches
# ---------------------------------------------------------------------------
.eslintcache
.cache/

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Packaging / release artifacts
# ---------------------------------------------------------------------------
*.tgz
*.tar.gz

# ---------------------------------------------------------------------------
# IDE / editors
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------------------------------------------------------------------------
# Local-only agent state
# ---------------------------------------------------------------------------
AGENTS.local.md

# Leak-scan local state. The marker dictionary lists real internal values, so
# it must never be committed; the canonical copy lives outside the repository
# entirely (~/.dsh-leak-markers.txt). The allowlist extension is machine-local.
# ---------------------------------------------------------------------------
.dsh-leak-markers.txt
.dsh-leak-allow.txt

# ---------------------------------------------------------------------------
# Plugin store files
# A store resolves to the working directory when $DSH_HOME is unset, so running
# a plugin's tests or a local script from its own directory drops the live
# store — accounts, credentials, audit trail — right there.
# ---------------------------------------------------------------------------
qa-accounts.db
qa-accounts.json
qa-integrations.db
qa-integrations.json
qa-quality.json
qa-capability-policies.json
qa-sources.json
qa-sources/
qa-*.db-wal
qa-*.db-shm

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
__pycache__/
site-packages/
venv/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
