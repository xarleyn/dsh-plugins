{
  "$schema": "node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "production": [
      "default",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/eslint.config.js"
    ],
    "rootEslintConfig": ["{workspaceRoot}/eslint.config.js"]
  },
  "release": {
    "projects": [
      "plugins/*",
      "packages/plugin-log",
      "packages/plugin-kit",
      "packages/audit-core",
      "packages/audit-ui"
    ],
    "projectsRelationship": "independent",
    "versionPlans": {
      "ignorePatternsForPlanCheck": ["**/CHANGELOG.md", "**/package.json"]
    },
    "version": {
      "updateDependents": "never"
    },
    "git": {
      "tag": false
    },
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": true
    }
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/lib"],
      "cache": true
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "lint": {
      "inputs": ["default", "rootEslintConfig"],
      "cache": true
    },
    "verify": {
      "dependsOn": ["build"],
      "inputs": ["production", "^production"],
      "cache": true
    }
  },
  "analytics": false
}
