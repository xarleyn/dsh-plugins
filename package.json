{
  "name": "dsh-plugins",
  "private": true,
  "version": "0.0.0",
  "description": "Installable DeepSeek Harness (DSH) plugins: session workspace scoping, documentation-impact tracking, prompt-injection and firewall controls, draft sessions, localization overrides, KV persistence, and developer tooling.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugins",
    "monorepo",
    "agent-harness",
    "llm"
  ],
  "homepage": "https://github.com/xarleyn/dsh-plugins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xarleyn/dsh-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/xarleyn/dsh-plugins/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "pnpm test:release && nx run-many -t test",
    "test:coverage": "nx run-many -t test:coverage --parallel=1",
    "test:release": "node --test scripts/publish-release.test.mjs scripts/release-workflow.test.mjs scripts/ci-verification.test.mjs scripts/check-pr-rules.test.mjs scripts/qa-changelog-contract.test.mjs scripts/verify-retired-seats.test.mjs scripts/run-bash.test.mjs scripts/qa-stand-launch-token.test.mjs scripts/package-hygiene.test.mjs scripts/package-hygiene-content.test.mjs scripts/package-hygiene-changelog.test.mjs scripts/package-hygiene-client.test.mjs scripts/check-dependencies.test.mjs scripts/check-release-plans.test.mjs scripts/generate-plugins-manifest.test.mjs scripts/json-schema-validate.test.mjs scripts/repo-config.test.mjs scripts/check-file-budget.test.mjs scripts/wave-release-notes.test.mjs scripts/verify-button-names.test.mjs scripts/verify-testids.test.mjs scripts/verify-design-tokens.test.mjs packages/plugin-scripts/run-verify-package.test.mjs packages/plugin-scripts/verify-plugin-card-contract.test.mjs",
    "typecheck": "nx run-many -t typecheck",
    "lint": "pnpm lint:workspace && nx run-many -t lint",
    "lint:workspace": "eslint eslint.config.js scripts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "verify": "pnpm verify:packages && pnpm verify:logging && pnpm verify:a11y && pnpm verify:testids && pnpm verify:tokens && nx run-many -t verify",
    "verify:pr-rules": "node scripts/check-pr-rules.mjs",
    "verify:seats": "node scripts/verify-retired-seats.mjs",
    "verify:packages": "node scripts/verify-package-hygiene.mjs",
    "verify:logging": "node scripts/verify-plugin-logging.mjs",
    "verify:a11y": "node scripts/verify-button-names.mjs",
    "verify:testids": "node scripts/verify-testids.mjs",
    "verify:tokens": "node scripts/verify-design-tokens.mjs",
    "plugins:manifest": "node scripts/generate-plugins-manifest.mjs",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm test && pnpm build && pnpm check:files && pnpm verify && pnpm deps:check",
    "check:files": "node scripts/check-file-budget.mjs",
    "deps:check": "node scripts/run-bash.mjs scripts/check-dependencies.sh",
    "tarball:verify": "node scripts/run-bash.mjs scripts/tarball-verify.sh --all",
    "tarball:verify:packages": "node scripts/run-bash.mjs scripts/tarball-verify.sh",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test",
    "affected:typecheck": "nx affected -t typecheck",
    "affected:lint": "nx affected -t lint",
    "affected:check": "nx affected -t lint typecheck test build verify",
    "release:plan": "nx release plan",
    "release:check": "node scripts/check-release-plans.mjs",
    "release:dry-run": "nx release --dry-run"
  },
