{
  "name": "@yadsh/dsh-plugin-kit",
  "private": true,
  "version": "0.1.0",
  "description": "Shared runtime helpers for DSH plugins",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    }
  },
  "files": [
    "lib",
    "LICENSE"
  ],
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh",
    "react": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh-dev",
    "@types/react": "catalog:frontend-dev",
    "@yadsh/dsh-config": "workspace:^",
    "eslint": "catalog:tooling",
    "react": "catalog:frontend-dev",
    "typescript": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src tests",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
