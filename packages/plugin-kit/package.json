{
  "name": "@yadsh/dsh-plugin-kit",
  "version": "0.3.0",
  "description": "Shared runtime helpers for DSH plugins: logging scaffolds, config validation, compatibility checks and SQLite store plumbing",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./sqlite": {
      "types": "./lib/sqlite.d.ts",
      "default": "./lib/sqlite.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin-kit",
    "sqlite",
    "storage"
  ],
  "homepage": "https://github.com/xarleyn/dsh-plugins/tree/main/packages/plugin-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xarleyn/dsh-plugins.git",
    "directory": "packages/plugin-kit"
  },
  "bugs": {
    "url": "https://github.com/xarleyn/dsh-plugins/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh-dev",
    "@testing-library/react": "^16.3.0",
    "@types/node": "catalog:tooling",
    "@types/react": "catalog:frontend-dev",
    "@types/react-dom": "catalog:frontend-dev",
    "@yadsh/dsh-config": "workspace:^",
    "eslint": "catalog:tooling",
    "jsdom": "catalog:tooling",
    "react": "catalog:frontend-dev",
    "react-dom": "catalog:frontend-dev",
    "typescript": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
