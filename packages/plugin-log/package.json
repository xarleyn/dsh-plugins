{
  "name": "@yadsh/dsh-plugin-log",
  "version": "0.4.0",
  "description": "Shared structured file logging and runtime logger discovery for DSH plugins",
  "homepage": "https://github.com/xarleyn/dsh-plugins/tree/main/packages/plugin-log#readme",
  "bugs": {
    "url": "https://github.com/xarleyn/dsh-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xarleyn/dsh-plugins.git",
    "directory": "packages/plugin-log"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "logging",
    "logs",
    "structured-logging",
    "observability"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "pnpm run verify:package",
    "prepack": "pnpm run build",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run verify"
  },
  "dependencies": {
    "@pinojs/redact": "^0.4.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@vitest/coverage-v8": "catalog:tooling",
    "@yadsh/dsh-config": "workspace:^",
    "@yadsh/dsh-plugin-scripts": "workspace:^",
    "@yadsh/dsh-test-kit": "workspace:^",
    "eslint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  }
}
