{
  "name": "@yadsh/dsh-test-kit",
  "version": "0.1.0",
  "description": "Testing utilities for DSH plugins",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "LICENSE"
  ],
  "dependencies": {
    "@yadsh/dsh-plugin-kit": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh",
    "vitest": "catalog:tooling"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh-dev",
    "@yadsh/dsh-config": "workspace:^",
    "@types/node": "catalog:tooling",
    "eslint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src tests",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
