{
  "name": "@yadsh/dsh-answer-review-gate",
  "version": "0.2.12",
  "description": "Independent answer review gate for DeepSeek Harness agent responses",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xarleyn/dsh-plugins.git",
    "directory": "plugins/dsh-answer-review-gate"
  },
  "homepage": "https://github.com/xarleyn/dsh-plugins/tree/main/plugins/dsh-answer-review-gate#readme",
  "bugs": {
    "url": "https://github.com/xarleyn/dsh-plugins/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/en.json": "./locale/en.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "compatibility.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "external": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@yadsh/dsh-plugin-kit": "workspace:^",
    "@yadsh/dsh-plugin-log": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-plugin-manager": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh",
    "@deepseek-ai/cordis": "catalog:dsh",
    "@deepseek-ai/dsh-llm": "catalog:dsh",
    "@deepseek-ai/schemastery": "catalog:dsh",
    "@deepseek-ai/dsh-scope": "catalog:dsh"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-plugin-manager": "catalog:dsh-dev",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh-dev",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:dsh-dev",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh-dev",
    "@testing-library/react": "^16.3.0",
    "@types/react": "catalog:frontend-dev",
    "@types/react-dom": "catalog:frontend-dev",
    "react": "catalog:frontend-dev",
    "react-dom": "catalog:frontend-dev",
    "jsdom": "catalog:tooling",
    "tsdown": "catalog:tooling",
    "@deepseek-ai/cordis": "catalog:dsh-dev",
    "@deepseek-ai/dsh-llm": "catalog:dsh-dev",
    "@deepseek-ai/dsh-session": "catalog:dsh-dev",
    "@deepseek-ai/schemastery": "catalog:dsh-dev",
    "@types/node": "catalog:tooling",
    "@vitest/coverage-v8": "catalog:tooling",
    "@yadsh/dsh-config": "workspace:^",
    "@yadsh/dsh-plugin-scripts": "workspace:^",
    "@yadsh/dsh-test-kit": "workspace:^",
    "eslint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vitest": "catalog:tooling",
    "@deepseek-ai/dsh-scope": "catalog:dsh-dev"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "answer-review",
    "agent",
    "cordis",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-answer-review-gate",
    "dsh-plugin",
    "quality-gate",
    "review-gate"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && tsdown",
    "lint": "eslint src tests scripts tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "pnpm run verify:package",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run verify",
    "prepack": "pnpm run build && pnpm run verify"
  }
}
