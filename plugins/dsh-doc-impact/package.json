{
  "name": "@yadsh/dsh-doc-impact",
  "version": "0.3.3",
  "description": "Deterministic documentation impact engine for DeepSeek Harness",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "documentation",
    "impact-analysis",
    "docs"
  ],
  "homepage": "https://github.com/xarleyn/dsh-plugins/tree/main/plugins/dsh-doc-impact#readme",
  "bugs": {
    "url": "https://github.com/xarleyn/dsh-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xarleyn/dsh-plugins.git",
    "directory": "plugins/dsh-doc-impact"
  },
  "license": "MIT",
  "author": "xarleyn",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "compatibility.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"const fs = require('node:fs'); for (const dir of ['lib']) fs.rmSync(dir, { recursive: true, force: true })\"",
    "build:client": "tsdown",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && pnpm run build:client",
    "lint": "eslint src tests scripts tsdown.config.ts",
    "test": "pnpm run build:client && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:client": "node scripts/verify-client-bundle.mjs",
    "smoke:packed": "node scripts/smoke-packed.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "pnpm run verify:client && pnpm run verify:package",
    "prepack": "pnpm run build && pnpm run verify:client",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run verify",
    "release:check": "pnpm run check && pnpm run verify:package"
  },
  "nx": {
    "targets": {
      "verify": {
        "dependsOn": [
          "build",
          "test"
        ]
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@yadsh/dsh-plugin-log": "workspace:^",
    "picomatch": "^4.0.3",
    "tinyglobby": "^0.2.14",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh",
    "@deepseek-ai/dsh-llm": "catalog:dsh",
    "@deepseek-ai/dsh-tools": "catalog:dsh",
    "@deepseek-ai/schemastery": "catalog:dsh",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh-dev",
    "@deepseek-ai/dsh-llm": "catalog:dsh-dev",
    "@deepseek-ai/dsh-tools": "catalog:dsh-dev",
    "@deepseek-ai/schemastery": "catalog:dsh-dev",
    "@types/node": "catalog:tooling",
    "@types/picomatch": "^4.0.2",
    "@types/react": "catalog:frontend-dev",
    "@yadsh/dsh-config": "workspace:^",
    "@yadsh/dsh-plugin-kit": "workspace:^",
    "@yadsh/dsh-test-kit": "workspace:^",
    "eslint": "catalog:tooling",
    "react": "catalog:frontend-dev",
    "tsdown": "catalog:tooling",
    "typescript": "catalog:plugin-tooling",
    "vitest": "catalog:tooling"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
