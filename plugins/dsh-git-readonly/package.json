{
  "name": "@yadsh/dsh-git-readonly",
  "version": "0.0.0",
  "description": "Read-only git provenance tools for DeepSeek Harness agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xarleyn/dsh-plugins.git",
    "directory": "plugins/dsh-git-readonly"
  },
  "homepage": "https://github.com/xarleyn/dsh-plugins/tree/main/plugins/dsh-git-readonly#readme",
  "bugs": {
    "url": "https://github.com/xarleyn/dsh-plugins/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "compatibility.json",
    "README.md",
    "SPEC.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@yadsh/dsh-plugin-log": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "catalog:dsh",
    "@deepseek-ai/schemastery": "catalog:dsh"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "catalog:dsh-dev",
    "@deepseek-ai/schemastery": "catalog:dsh-dev",
    "@types/node": "catalog:tooling",
    "@yadsh/dsh-config": "workspace:^",
    "@yadsh/dsh-test-kit": "workspace:^",
    "eslint": "catalog:tooling",
    "typescript": "catalog:plugin-tooling",
    "vitest": "catalog:tooling"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "pnpm run verify:package",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run verify",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "git",
    "read-only",
    "provenance",
    "agent-tools"
  ]
}
