{
  "name": "@yadsh/dsh-jev-compaction",
  "version": "0.1.1",
  "description": "Jev/System-One semantic pruning of stale tool results for DeepSeek Harness; keeps conversation text verbatim and forgets stale tool output before summary compaction is needed",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xarleyn/dsh-plugins.git",
    "directory": "plugins/dsh-jev-compaction"
  },
  "homepage": "https://github.com/xarleyn/dsh-plugins/tree/main/plugins/dsh-jev-compaction#readme",
  "bugs": {
    "url": "https://github.com/xarleyn/dsh-plugins/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./backend": {
      "types": "./lib/backend/index.d.ts",
      "default": "./lib/backend/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "compatibility.json",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "external": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@yadsh/dsh-plugin-log": "workspace:^",
    "@yadsh/dsh-plugin-kit": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh",
    "@deepseek-ai/dsh-compaction": "catalog:dsh",
    "@deepseek-ai/dsh-compaction-basic": "catalog:dsh",
    "@deepseek-ai/dsh-llm": "catalog:dsh",
    "@deepseek-ai/dsh-session": "catalog:dsh",
    "@deepseek-ai/schemastery": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh",
    "@deepseek-ai/dsh-home-paths": "catalog:dsh",
    "@deepseek-ai/dsh-tools": "catalog:dsh",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh",
    "@deepseek-ai/dsh-compaction": "catalog:dsh-dev",
    "@deepseek-ai/dsh-compaction-basic": "catalog:dsh-dev",
    "@deepseek-ai/dsh-llm": "catalog:dsh-dev",
    "@deepseek-ai/dsh-session": "catalog:dsh-dev",
    "@deepseek-ai/schemastery": "catalog:dsh-dev",
    "@types/node": "catalog:tooling",
    "@yadsh/dsh-config": "workspace:^",
    "@yadsh/dsh-test-kit": "workspace:^",
    "eslint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vitest": "catalog:tooling",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh-dev",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:dsh-dev",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "catalog:dsh-dev",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh-dev",
    "@deepseek-ai/dsh-home-paths": "catalog:dsh-dev",
    "@deepseek-ai/dsh-tools": "catalog:dsh-dev",
    "@testing-library/react": "^16.3.0",
    "@types/react": "catalog:frontend-dev",
    "@types/react-dom": "catalog:frontend-dev",
    "jsdom": "catalog:tooling",
    "react": "catalog:frontend-dev",
    "react-dom": "catalog:frontend-dev",
    "tsdown": "catalog:tooling",
    "@yadsh/dsh-plugin-scripts": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "dsh-jev-compaction",
    "jev",
    "system-one",
    "compaction",
    "context-window",
    "session-surface",
    "result-shaping",
    "tool-output",
    "settings-card"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && tsdown",
    "lint": "eslint src tests scripts tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "vitest run tests/eval",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "pnpm run verify:package",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run verify",
    "prepack": "pnpm run build && pnpm run verify"
  }
}
