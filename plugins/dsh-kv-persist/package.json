{
  "name": "@yadsh/dsh-kv-persist",
  "version": "0.1.0",
  "description": "Persistent KV-cache/session-state manager for DeepSeek Harness (llama.cpp slot snapshots)",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "kv-cache",
    "llama-cpp",
    "persistence"
  ],
  "homepage": "https://github.com/xarleyn/dsh-kv-persist#readme",
  "bugs": {
    "url": "https://github.com/xarleyn/dsh-kv-persist/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xarleyn/dsh-kv-persist.git"
  },
  "license": "MIT",
  "author": "xarleyn",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "compatibility.json",
    "docs/dsh-kv-persist.md",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:llama": "vitest run test/integration/llama-server.test.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "npm run verify:package",
    "check": "npm run typecheck && npm test && npm run build && npm run verify"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh",
    "@deepseek-ai/dsh-llm": "catalog:dsh",
    "@deepseek-ai/schemastery": "catalog:dsh"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh-dev",
    "@deepseek-ai/dsh-llm": "catalog:dsh-dev",
    "@deepseek-ai/schemastery": "catalog:dsh-dev",
    "@types/node": "catalog:tooling",
    "@yadsh/dsh-config": "workspace:^",
    "eslint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vitest": "catalog:tooling"
  }
}
