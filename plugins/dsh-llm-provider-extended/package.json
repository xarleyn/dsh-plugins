{
  "name": "@yadsh/dsh-llm-provider-extended",
  "version": "0.0.0",
  "description": "Full DSH provider adapter with generation controls and typed System One decisions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xarleyn/dsh-plugins.git",
    "directory": "plugins/dsh-llm-provider-extended"
  },
  "homepage": "https://github.com/xarleyn/dsh-plugins/tree/main/plugins/dsh-llm-provider-extended#readme",
  "bugs": {
    "url": "https://github.com/xarleyn/dsh-plugins/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "compatibility.json",
    "README.md",
    "LICENSE",
    "locale",
    "UPSTREAM_LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "external": [
        "react",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@yadsh/dsh-plugin-log": "workspace:^",
    "@deepseek-ai/dsh-brand": "0.1.7-rc.2",
    "@deepseek-ai/dsh-util-values": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "catalog:dsh",
    "@earendil-works/pi-ai": "0.85.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh",
    "@deepseek-ai/dsh-attachment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-authorization": "0.1.7-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.7-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.7-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.7-rc.2",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.5",
    "@deepseek-ai/dsh-settings": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh-dev",
    "@types/node": "catalog:tooling",
    "@yadsh/dsh-config": "workspace:^",
    "eslint": "catalog:tooling",
    "typescript": "catalog:tooling",
    "tsdown": "catalog:tooling",
    "@yadsh/dsh-test-kit": "workspace:^",
    "@vitest/coverage-v8": "catalog:tooling",
    "vitest": "catalog:tooling",
    "@deepseek-ai/dsh-attachment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-authorization": "0.1.7-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.7-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.7-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.7-rc.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-settings": "catalog:dsh-dev",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "catalog:dsh-dev",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh-dev",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:dsh-dev",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh-dev",
    "@yadsh/dsh-plugin-kit": "workspace:^",
    "react": "catalog:frontend-dev",
    "@types/react": "catalog:frontend-dev",
    "react-dom": "catalog:frontend-dev",
    "jsdom": "catalog:tooling",
    "@testing-library/react": "^16.3.0",
    "@deepseek-ai/dsh-credentials-local": "0.1.7-rc.2",
    "@deepseek-ai/dsh-http-proxy": "0.1.7-rc.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "dsh-llm-provider-extended"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "lint": "eslint src tests scripts tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:client": "node scripts/verify-client-bundle.mjs",
    "verify": "pnpm run verify:package && pnpm run verify:client",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run verify",
    "prepack": "pnpm run build && pnpm run verify"
  }
}
