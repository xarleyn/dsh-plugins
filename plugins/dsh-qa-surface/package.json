{
  "name": "@yadsh/dsh-qa-surface",
  "version": "0.5.0",
  "description": "A focused end-user QA surface backed by native DeepSeek Harness sessions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xarleyn/dsh-plugins.git",
    "directory": "plugins/dsh-qa-surface"
  },
  "homepage": "https://github.com/xarleyn/dsh-plugins/tree/main/plugins/dsh-qa-surface#readme",
  "bugs": {
    "url": "https://github.com/xarleyn/dsh-plugins/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "bin": {
    "qa-accounts": "./lib/cli.js",
    "qa-repair-sessions": "./scripts/repair-session-events.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./client/panels": {
      "types": "./lib/types/client/panels/index.d.ts",
      "default": "./lib/client/panels/index.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "external": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-agent-presets",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-file-upload",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "scripts/repair-session-events.mjs",
    "cordis.patch.yml",
    "compatibility.json",
    "capability-policy.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "pnpm run clean && node scripts/generate-typert.mjs && tsc -p tsconfig.build.json && tsdown",
    "lint": "eslint src tests scripts tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "pnpm run verify:package && pnpm run verify:consumer",
    "verify:consumer": "tsc -p scripts/fixtures/tsconfig.json --noEmit",
    "smoke:packed": "node scripts/smoke-packed-dsh.mjs",
    "e2e:browser": "node scripts/smoke-packed-dsh.mjs --browser",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run verify",
    "prepack": "pnpm run build && pnpm run verify",
    "prepublishOnly": "pnpm run check"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "qa",
    "chat",
    "web-ui",
    "testing",
    "quality-assurance"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh",
    "@deepseek-ai/schemastery": "catalog:dsh",
    "@deepseek-ai/dsh-api-gateway": "catalog:dsh",
    "@deepseek-ai/dsh-agent": "catalog:dsh",
    "@deepseek-ai/dsh-agent-presets": "catalog:dsh",
    "@deepseek-ai/dsh-api-session-controller": "catalog:dsh",
    "@deepseek-ai/dsh-api-workspace-controller": "catalog:dsh",
    "@deepseek-ai/dsh-client-connection": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-conversation": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-chat": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-layout": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-theme": "catalog:dsh",
    "@deepseek-ai/dsh-host-webserver": "catalog:dsh",
    "@deepseek-ai/dsh-llm": "catalog:dsh",
    "@deepseek-ai/dsh-permission-presets": "catalog:dsh",
    "@deepseek-ai/dsh-session": "catalog:dsh",
    "@deepseek-ai/dsh-settings": "catalog:dsh",
    "@deepseek-ai/dsh-skill": "catalog:dsh",
    "@deepseek-ai/dsh-system-prompt": "catalog:dsh",
    "@deepseek-ai/dsh-tools": "catalog:dsh",
    "@deepseek-ai/dsh-typert-protocol": "catalog:dsh",
    "@deepseek-ai/dsh-workspace": "catalog:dsh",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@yadsh/dsh-plugin-log": "workspace:^",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh-dev",
    "@deepseek-ai/schemastery": "catalog:dsh-dev",
    "@deepseek-ai/dsh-api-gateway": "catalog:dsh-dev",
    "@deepseek-ai/dsh-agent": "catalog:dsh-dev",
    "@deepseek-ai/dsh-agent-presets": "catalog:dsh-dev",
    "@deepseek-ai/dsh-api-session-controller": "catalog:dsh-dev",
    "@deepseek-ai/dsh-api-workspace-controller": "catalog:dsh-dev",
    "@deepseek-ai/dsh-client-connection": "catalog:dsh-dev",
    "@deepseek-ai/dsh-client-ui-conversation": "catalog:dsh-dev",
    "@deepseek-ai/dsh-client-ui-chat": "catalog:dsh-dev",
    "@deepseek-ai/dsh-client-ui-layout": "catalog:dsh-dev",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh-dev",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:dsh-dev",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "catalog:dsh-dev",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh-dev",
    "@deepseek-ai/dsh-client-ui-theme": "catalog:dsh-dev",
    "@deepseek-ai/dsh-host-webserver": "catalog:dsh-dev",
    "@deepseek-ai/dsh-llm": "catalog:dsh-dev",
    "@deepseek-ai/dsh-permission-presets": "catalog:dsh-dev",
    "@deepseek-ai/dsh-scope": "catalog:dsh-dev",
    "@deepseek-ai/dsh-session": "catalog:dsh-dev",
    "@deepseek-ai/dsh-settings": "catalog:dsh-dev",
    "@deepseek-ai/dsh-skill": "catalog:dsh-dev",
    "@deepseek-ai/dsh-system-prompt": "catalog:dsh-dev",
    "@deepseek-ai/dsh-tools": "catalog:dsh-dev",
    "@deepseek-ai/dsh-typert-generator": "catalog:dsh-dev",
    "@deepseek-ai/dsh-typert-protocol": "catalog:dsh-dev",
    "@deepseek-ai/dsh-workspace": "catalog:dsh-dev",
    "@testing-library/react": "^16.3.0",
    "@types/node": "catalog:tooling",
    "@types/react": "catalog:frontend-dev",
    "@types/react-dom": "catalog:frontend-dev",
    "@yadsh/dsh-config": "workspace:^",
    "@yadsh/dsh-plugin-kit": "workspace:^",
    "@yadsh/dsh-plugin-scripts": "workspace:^",
    "eslint": "catalog:tooling",
    "jsdom": "catalog:tooling",
    "playwright": "catalog:tooling",
    "react": "catalog:frontend-dev",
    "react-dom": "catalog:frontend-dev",
    "tsdown": "catalog:tooling",
    "typescript": "catalog:plugin-tooling",
    "vitest": "catalog:tooling"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
