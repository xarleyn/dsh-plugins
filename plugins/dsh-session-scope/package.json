{
  "name": "@yadsh/dsh-session-scope",
  "version": "0.6.0",
  "description": "Per-session workspace visibility scopes for DeepSeek Harness.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "import": "./lib/client.js",
      "default": "./lib/client.js"
    },
    "./core": {
      "types": "./lib/core.d.ts",
      "import": "./lib/core.js"
    },
    "./session-scope": {
      "types": "./lib/session-scope.d.ts",
      "import": "./lib/session-scope.js"
    },
    "./host-api": {
      "types": "./lib/host-api.d.ts",
      "import": "./lib/host-api.js"
    },
    "./scope-visibility": {
      "types": "./lib/scope-visibility.d.ts",
      "import": "./lib/scope-visibility.js"
    },
    "./scope-context": {
      "types": "./lib/scope-context.d.ts",
      "import": "./lib/scope-context.js"
    },
    "./scope-delegation": {
      "types": "./lib/scope-delegation.d.ts",
      "import": "./lib/scope-delegation.js"
    },
    "./scope-fs": {
      "types": "./lib/scope-fs.d.ts",
      "import": "./lib/scope-fs.js"
    },
    "./scope-processes": {
      "types": "./lib/scope-processes.d.ts",
      "import": "./lib/scope-processes.js"
    },
    "./scope-sandbox-linux": {
      "types": "./lib/scope-sandbox-linux.d.ts",
      "import": "./lib/scope-sandbox-linux.js"
    },
    "./tool-guard": {
      "types": "./lib/tool-guard.d.ts",
      "import": "./lib/tool-guard.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "compatibility.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:client": "node scripts/verify-client-bundle.mjs",
    "verify:compatibility": "node scripts/verify-compatibility.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "npm run verify:client && npm run verify:compatibility && npm run verify:package",
    "check": "npm run build && npm test && npm run verify",
    "smoke:packed": "node scripts/smoke-packed-dsh.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "prepublishOnly": "npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh",
    "@deepseek-ai/dsh-fs": "catalog:dsh",
    "@deepseek-ai/dsh-sandbox": "catalog:dsh",
    "@deepseek-ai/dsh-session": "catalog:dsh",
    "@deepseek-ai/dsh-typert-protocol": "catalog:dsh",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "sandbox",
    "permission",
    "session-scope",
    "workspace-scope"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xarleyn/dsh-plugins.git",
    "directory": "plugins/dsh-session-scope"
  },
  "bugs": {
    "url": "https://github.com/xarleyn/dsh-plugins/issues"
  },
  "homepage": "https://github.com/xarleyn/dsh-plugins/tree/main/plugins/dsh-session-scope#readme",
  "author": "xarleyn",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:dsh-dev",
    "@deepseek-ai/dsh-fs": "catalog:dsh-dev",
    "@deepseek-ai/dsh-sandbox": "catalog:dsh-dev",
    "@deepseek-ai/dsh-session": "catalog:dsh-dev",
    "@deepseek-ai/dsh-typert-protocol": "catalog:dsh-dev",
    "@types/node": "catalog:tooling",
    "@types/react": "catalog:frontend-dev",
    "@types/react-dom": "catalog:frontend-dev",
    "eslint": "catalog:tooling",
    "react": "catalog:frontend-dev",
    "react-dom": "catalog:frontend-dev",
    "typescript": "catalog:plugin-tooling",
    "vitest": "catalog:tooling"
  }
}
