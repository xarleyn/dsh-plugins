{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DSH Plugin Generator",
  "description": "Scaffold a new DSH plugin in the monorepo.",
  "type": "object",
  "properties": {
    "name": {
      "description": "Plugin name (kebab-case).",
      "type": "string",
      "$default": {
        "$source": "argv",
        "index": 0
      }
    },
    "client": {
      "description": "Include a ModuleLoader-compatible browser client entrypoint.",
      "type": "boolean",
      "default": false
    },
    "description": {
      "description": "Short description of the plugin.",
      "type": "string"
    },
    "scope": {
      "description": "npm scope prefix (e.g., @yadsh).",
      "type": "string",
      "default": "@yadsh"
    },
    "withUi": {
      "description": "Use the repository UI kit (requires packages/ui-kit).",
      "type": "boolean",
      "default": false
    },
    "withTests": {
      "description": "Include pre-configured test setup with fixture helpers.",
      "type": "boolean",
      "default": true
    }
  },
  "required": ["name"]
}
